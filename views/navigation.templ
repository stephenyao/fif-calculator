package views

import . "fif-calculator/internal/viewmodel"

templ NavigationMenu(viewModel *NavigationViewModel) {
    <nav class="bg-white dark:bg-gray-900 shadow-md p-2 sm:p-4 border-b border-gray-200 dark:border-gray-700 overflow-x-auto">
        <ul class="flex flex-row justify-center space-x-2 sm:space-x-4 max-w-4xl w-full mx-auto">
            for _, item := range viewModel.Items {
                <li class="flex-shrink-0">
                    <a
                        href={item.URL}
                        class={
                            "flex flex-col sm:flex-row items-center sm:items-start justify-center text-sm sm:text-base font-medium py-2 px-3 sm:px-4 rounded-md transition-all duration-200 ease-in-out " +
                            className(item.IsActive)
                        }
                    >
                        if item.Icon != "" {
                            <svg class="w-5 h-5 mb-1 sm:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d={item.Icon}></path>
                            </svg>
                        }
                        <span class="text-center sm:text-left">{item.Title}</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
}

func className(isActive bool) string {
    if isActive {
        return "bg-blue-600 text-white shadow-md"
    } else {
        return "text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-blue-600"
    }
}
