package views

templ navigationMenu() {
    <nav class="bg-white shadow-md p-4 border-b border-gray-200 flex flex-row overflow-x-auto">
        <ul class="flex flex-row space-x-4 max-w-4xl w-full mx-auto ">
            <li class="flex-shrink-0">
                <button
                    class="block w-full text-left py-2 px-4 rounded-lg transition-all duration-200 ease-in-out
                           bg-blue-500 text-white shadow-md"
                    onclick="alert('Navigate to Manage Trades')"
                >
                    Manage Trades
                </button>
            </li>
            <li class="flex-shrink-0">
                <button
                    class="block w-full text-left py-2 px-4 rounded-lg transition-all duration-200 ease-in-out
                           text-gray-700 hover:bg-gray-100 hover:text-blue-600"
                    onclick="alert('Navigate to Cost Basis')"
                >
                    Cost Basis
                </button>
            </li>
            <li class="flex-shrink-0">
                <button
                    class="block w-full text-left py-2 px-4 rounded-lg transition-all duration-200 ease-in-out
                           text-gray-700 hover:bg-gray-100 hover:text-blue-600"
                    onclick="alert('Navigate to FIF Calculation')"
                >
                    FIF Calculation
                </button>
            </li>
            <li class="flex-shrink-0">
                <button
                    class="block w-full text-left py-2 px-4 rounded-lg transition-all duration-200 ease-in-out
                           text-gray-700 hover:bg-gray-100 hover:text-blue-600"
                    onclick="alert('Navigate to FIF Report')"
                >
                    FIF Report
                </button>
            </li>
        </ul>
    </nav>
}