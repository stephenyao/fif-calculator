package views

import "fif-calculator/internal/viewmodel"

templ Label(target, content string) {
	<label
		for={ target }
		class="block mb-1 font-medium text-gray-700a"
	>{ content }</label>
}

templ Input(id, name, inputType, value string) {
	<input
		id={ id }
		value={ value }
		name={ name }
		type={ inputType }
		class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring focus:ring-blue-300"
	/>
}

templ CurrencySelect(id, name string, currencies []viewmodel.Currency, selected string) {
	<select
		id={ id }
		name={ name }
		class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring focus:ring-blue-300"
	>
		for _, currency := range currencies {
			if currency.Code == selected {
				<option value={ currency.Code } selected>{ currency.DisplayValue() }</option>
			} else {
				<option value={ currency.Code }>{ currency.DisplayValue() }</option>
			}
		}
	</select>
}

templ SubmitButton(text string) {
	<button
		type="submit"
		class="bg-blue-600 text-white font-medium py-2 px-4 rounded hover:bg-blue-700 transition"
	>
		{text}
	</button>
}

templ DestructButton(text string) {
	<button
	    type="submit"
	     class="mt-4 bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700"
	 >
		{text}
	</button>
}
