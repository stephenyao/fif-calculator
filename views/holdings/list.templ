package holdings

import "fif-calculator/internal/viewmodel"
import . "fif-calculator/views"
import "strconv"

templ HoldingsList(currentPath string, viewModels []viewmodel.HoldingViewModel) {
	@Layout("Holdings List", currentPath) {
		@Page() {
			<div class="flex justify-between w-full">
				@H2("Holdings")
				<div class="flex justify-end mb-4">
					@Link("/holdings/new", "+ New")
				</div>
			</div>
			@Section() {
				<div>
					if len(viewModels) == 0 {
						<p class="text-gray-600 dark:text-gray-400">You have no holdings yet.</p>
					} else {
						@HoldingsCards(viewModels)
						@HoldingsTable(viewModels)
					}
				</div>
			}
		}
	}
}

templ HoldingsTable(viewModels []viewmodel.HoldingViewModel) {
	<div class="hidden md:block">
		@TableList() {
			@THead() {
				@TH("Name")
				@TH("Symbol")
				@TH("Total Trades")
				@TH("Quantity")
				@TH("Cost (NZD)")
				@TH("")
			}
			<tbody>
				<script>
                    function navigateToDetails(path) {
                        window.location.href = path
                    }
                </script>
				for _, vm := range viewModels {
					@TR("navigateToDetails", "holdings/"+strconv.Itoa(vm.ID)) {
						@TD(vm.Name)
						@TD(vm.Symbol)
						@TD(vm.TotalTrades)
						@TD(vm.CurrentQuantity)
						@TD(vm.CostBasis)
						@TDChevron()
					}
				}
			</tbody>
		}
	</div>
}

templ HoldingsCards(viewModels []viewmodel.HoldingViewModel) {
	<div class="block md:hidden divide-y divide-gray-200 dark:divide-gray-700">
		for _, vm := range viewModels {
			<div
				onclick={ templ.JSFuncCall("navigateToDetails", "holdings/"+strconv.Itoa(vm.ID)) }
				class="py-4 px-4 text-sm hover:cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800"
			>
				<div class="flex justify-between items-center mb-2">
					<div class="font-semibold text-base">{ vm.Name }</div>
					<svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
					</svg>
				</div>
				<div class="grid grid-cols-2 gap-x-6 gap-y-4">
					<div class="space-y-2">
						@VPairedLabel("Symbol", vm.Symbol)
						@VPairedLabel("Quantity", vm.CurrentQuantity)
					</div>
					<div class="space-y-2">
						@VPairedLabel("Total Trades", vm.TotalTrades)
						@VPairedLabel("Cost (NZD)", vm.CostBasis)
					</div>
				</div>
			</div>
		}
	</div>
}
