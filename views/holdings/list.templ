package holdings

import "fif-calculator/internal/viewmodel"
import . "fif-calculator/views"
import "strconv"

templ HoldingsList(currentPath string, viewModels []viewmodel.HoldingViewModel) {
	@Layout("Holdings List", currentPath) {
		@Page() {
		    <div class="flex justify-between w-full">
                <h2 class="text-2xl font-bold mb-4">Holdings</h2>
                <div class="flex justify-end mb-4">
                    @Link("/holdings/new", "+ New")
                </div>
            </div>
			@Section() {
				<div>
					if len(viewModels) == 0 {
						<p class="text-gray-600">You have no holdings yet.</p>
					} else {
						<table class="min-w-full w-full text-sm">
                            <thead
                              class="border-b border-gray-100 text-left text-gray-800 tracking-wide font-semibold"
                            >
								<tr>
									<th class="px-4 py-3">Name</th>
									<th class="px-4 py-3">Symbol</th>
									<th class="px-4 py-3">Currency</th>
									<th class="px-4 py-3">Cost Basis</th>
									<th class="px-4 py-3"></th>
								</tr>
							</thead>
							<tbody>
								<script>
                                    function navigateToDetails(path) {
                                      window.location.href=path
                                    }
                                </script>
								for _, vm := range viewModels {
									<tr
									onclick={templ.JSFuncCall("navigateToDetails", "holdings/" + strconv.Itoa(vm.ID))}
										class="border-t hover:bg-gray-50"
									>
										<td class="px-4 py-3">{ vm.Name }</td>
										<td class="px-4 py-3">{ vm.Symbol }</td>
										<td class="px-4 py-3">{ vm.Currency }</td>
										<td class="px-4 py-3">$5.00</td>
										<td class="px-4 py-3">
										    <div class="flex justify-end">
                                                <svg
                                                class="w-5 h-5"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                viewBox="0 0 24 24"
                                                xmlns="http://www.w3.org/2000/svg"
                                                aria-hidden="true"
                                                >
                                                    <path
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round"
                                                      d="M9 5l7 7-7 7"
                                                    ></path>
                                              </svg>
                                            </div>
                                        </td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			}
		}
	}
}
