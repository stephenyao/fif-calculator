package holdings

import "fif-calculator/internal/viewmodel"

import . "fif-calculator/views"

templ EditHolding(currentPath string, viewModel *viewmodel.HoldingFormViewModel) {
	@Layout("New Holding", currentPath) {
		@Page() {
			@Section() {
				@edit(viewModel)
			}
		}
	}
}

templ edit(vm *viewmodel.HoldingFormViewModel) {
	<h2 class="text-2xl font-bold mb-4">Edit Holding</h2>
	<a href="/holdings" class="text-blue-600 underline">← Back to Holdings</a>
	@HoldingsForm(vm,  templ.SafeURL("/holdings/" + vm.ID + "/edit"))
}
