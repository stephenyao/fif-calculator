package holdings

import (
	"fif-calculator/internal/viewmodel"
	"strconv"

	. "fif-calculator/views"
	"fmt"
)

templ ViewHolding(currentPath string, vm viewmodel.HoldingViewModel) {
	@Layout("Holding Details", currentPath) {
		@Page() {
			@Section() {
				@holdingInfo(vm)
			}
			@Section() {
				@holdingTrades(vm)
			}
		}
	}
}

templ holdingInfo(vm viewmodel.HoldingViewModel) {
	<div class="mb-4">
		<a href="/holdings" class="text-blue-600 underline">
			← Back to Holdings
		</a>
	</div>
	@H2("Holding Information")
	<div class="mb-4">
		<p class="text-sm text-gray-600">Name</p>
		<p class="text-lg text-gray-900 font-medium">{ vm.Name }</p>
	</div>
	<div class="mb-4">
		<p class="text-sm text-gray-600">Symbol</p>
		<p class="text-lg text-gray-900 font-medium">{ vm.Symbol }</p>
	</div>
	<div class="mb-4">
		<p class="text-sm text-gray-600">Currency</p>
		<p class="text-lg text-gray-900 font-medium">{ vm.Currency }</p>
	</div>
	@Link("/holdings/"+strconv.Itoa(vm.ID)+"/edit", "Edit")
	<form action={ templ.SafeURL("/holdings/" + strconv.Itoa(vm.ID) + "/delete") } method="post" onsubmit="return confirm('Are you sure you want to delete this holding?');">
		@DestructButton("Delete")
	</form>
}

templ holdingTrades(vm viewmodel.HoldingViewModel) {
	<div>
		<h2 class="text-2xl font-bold mb-4">Trades</h2>
		<div class="flex justify-end mb-4">
			@Link("/holdings/"+strconv.Itoa(vm.ID)+"/trades/new", "+ New Trade")
		</div>
		if len(vm.Trades) == 0 {
			<p class="text-gray-600">No trades recorded yet.</p>
		} else {
			<div class="overflow-x-auto">
				@TableList() {
					@THead() {
						@TH("Date")
						@TH("Action")
						@TH("Quantity")
						@TH("Price")
						@TH("Currency")
						@TH("Actions")
					}
					<tbody>
						for _, trade := range vm.Trades {
							<tr>
								@TD(trade.TransactionDate)
								@TD(trade.Action)
								@TD(fmt.Sprintf("%.2f", trade.Quantity))
								@TD(fmt.Sprintf("%.2f", trade.Price))
								@TD(trade.Currency)
								@TDChild() {
									<a href={ templ.SafeURL(trade.URL) } class="inline-block px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 mx-auto">
										View
									</a>
								}
							</tr>
						}
					</tbody>
				}
			</div>
		}
	</div>
}
