package holdings

import (
	"fif-calculator/internal/viewmodel"
	"strconv"

	. "fif-calculator/views"
	"fmt"
)

templ ViewHolding(currentPath string, holdingsVm viewmodel.HoldingViewModel, tradesVm viewmodel.TradesViewModel) {
	@Layout("Holding Details", currentPath) {
		@Page() {
			@holdingInfo(holdingsVm)
			@holdingTrades(tradesVm)
		}
	}
}

templ holdingInfo(vm viewmodel.HoldingViewModel) {
	<div class="mb-4">
		<a href="/holdings" class="text-blue-600 underline">
			← Back to Holdings
		</a>
	</div>
	<div class="flex justify-between items-center mb-4">
		@H2("Holding Information")
		<div class="flex items-center gap-2">
			@Link("/holdings/"+strconv.Itoa(vm.ID)+"/edit", "Edit")
			<form action={ templ.SafeURL("/holdings/" + strconv.Itoa(vm.ID) + "/delete") } method="post" onsubmit="return confirm('Are you sure you want to delete this holding?');">
				@DestructButton("Delete")
			</form>
		</div>
	</div>
	@Section() {
		<div class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-2">
			<div class="mb-4">
				@VPairedLabel("Name", vm.Name)
			</div>
			<div class="mb-4">
				@VPairedLabel("Symbol", vm.Symbol)
			</div>
			<div class="mb-4">
				@VPairedLabel("Currency", vm.Currency)
			</div>
			<div class="mb-4">
				@VPairedLabel("Total Trades", vm.TotalTrades)
			</div>
			<div class="mb-4">
				@VPairedLabel("Quantity Held", vm.CurrentQuantity)
			</div>
			<div class="mb-4">
				@VPairedLabel("Cost (NZD)", vm.CostBasis)
			</div>
		</div>
	}
}

templ holdingTrades(vm viewmodel.TradesViewModel) {
	<div class="flex justify-between w-full">
		@H2("Trades")
		<div class="flex justify-end mb-4">
			@Link("/holdings/"+strconv.Itoa(vm.HoldingID)+"/trades/new", "+ New Trade")
		</div>
	</div>
	@Section() {
		if len(vm.Trades) == 0 {
			<p class="text-gray-600">No trades recorded yet.</p>
		} else {
			// This panel will be replaced by HTMX requests
			@TradesPanel(vm)
		}
	}
}

templ TradesPanel(vm viewmodel.TradesViewModel) {
	<div id="trades-panel" hx-target="#trades-panel" hx-swap="outerHTML">
		<div class="overflow-x-auto">
			@paginatedTrades(vm) {
				@THead() {
					@TH("Date")
					@TH("Action")
					@TH("Quantity")
					@TH("Price")
					@TH("Currency")
					@TH("Actions")
				}
				<tbody>
					for _, trade := range vm.Trades {
						<tr>
							@TD(trade.TransactionDate)
							@TD(trade.Action)
							@TD(fmt.Sprintf("%.2f", trade.Quantity))
							@TD(fmt.Sprintf("%.2f", trade.Price))
							@TD(trade.Currency)
							@TDChild() {
								<a href={ templ.SafeURL(trade.URL) } class="inline-block px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 mx-auto">
									View
								</a>
							}
						</tr>
					}
				</tbody>
			}
		</div>
	</div>
}

templ paginatedTrades(vm viewmodel.TradesViewModel) {
	<div class="w-full">
		<table class="min-w-full w-full text-sm text-gray-900 dark:text-gray-100">
			{ children... }
		</table>
		if vm.PageInfo.TotalPages > 1 {
			<div class="mt-4 flex justify-center items-center gap-2 text-sm">
				<a
					hx-get={ "/holdings/" + strconv.Itoa(vm.HoldingID) + "/trades?page=" + strconv.Itoa(vm.PageInfo.PreviousPage) }
					hx-push-url="true"
					class={classForPrevNavigation(vm.PageInfo.CurrentPage)}
				>←</a>
				for i := vm.PageInfo.StartPage; i <= vm.PageInfo.EndPage; i++ {
					<a
						hx-get={ "/holdings/" + strconv.Itoa(vm.HoldingID) + "/trades?page=" + strconv.Itoa(i) }
						hx-push-url="true"
						class={ classForPageSelector(i, vm.PageInfo.CurrentPage) }
					>{ i+1 }</a>
				}
				<a
					hx-get={ "/holdings/" + strconv.Itoa(vm.HoldingID) + "/trades?page=" + strconv.Itoa(vm.PageInfo.NextPage) }
					hx-push-url="true"
					class={classForNextNavigation(vm.PageInfo.CurrentPage, vm.PageInfo.TotalPages)}
				>→</a>
			</div>
		}
	</div>
}

func classForPageSelector(page, currentPage int) string {
	if page == currentPage {
		return "px-3 py-1 rounded border bg-blue-600 text-white border-blue-600 hover:bg-blue-700 select-none pointer-events-none"
	} else {
		return "px-3 py-1 rounded border hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer select-none"
	}
}

func classForPrevNavigation(currentPage int) string {
    class := "px-2 py-1 border rounded hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer select-none "

    if currentPage == 0 {
        class += "pointer-events-none"
    }

    return class
}

func classForNextNavigation(currentPage, totalPages int) string {
    class := "px-2 py-1 border rounded hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer select-none "

    if currentPage == totalPages - 1 {
        class += "pointer-events-none"
    }

    return class
}