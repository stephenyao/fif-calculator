package holdings

import (
	"fif-calculator/internal/viewmodel"
	"strconv"

	. "fif-calculator/views"
	"fmt"
)

templ ViewHolding(currentPath string, vm viewmodel.HoldingViewModel) {
	@Layout("Holding Details", currentPath) {
		@Page() {
			@holdingInfo(vm)
			@holdingTrades(vm)
		}
	}
}

templ holdingInfo(vm viewmodel.HoldingViewModel) {
	<div class="mb-4">
		<a href="/holdings" class="text-blue-600 underline">
			← Back to Holdings
		</a>
	</div>
	<div class="flex justify-between items-center mb-4">
		@H2("Holding Information")
		<div class="flex items-center gap-2">
			@Link("/holdings/"+strconv.Itoa(vm.ID)+"/edit", "Edit")
			<form action={ templ.SafeURL("/holdings/" + strconv.Itoa(vm.ID) + "/delete") } method="post" onsubmit="return confirm('Are you sure you want to delete this holding?');">
				@DestructButton("Delete")
			</form>
		</div>
	</div>
	@Section() {
		<div class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-2">
			<div class="mb-4">
				@VPairedLabel("Name", vm.Name)
			</div>
			<div class="mb-4">
				@VPairedLabel("Symbol", vm.Symbol)
			</div>
			<div class="mb-4">
				@VPairedLabel("Currency", vm.Currency)
			</div>
			<div class="mb-4">
				@VPairedLabel("Total Trades", vm.TotalTrades)
			</div>
			<div class="mb-4">
				@VPairedLabel("Quantity Held", vm.CurrentQuantity)
			</div>
			<div class="mb-4">
				@VPairedLabel("Cost (NZD)", vm.CostBasis)
			</div>
		</div>
	}
}

templ holdingTrades(vm viewmodel.HoldingViewModel) {
	<div class="flex justify-between w-full">
		@H2("Trades")
		<div class="flex justify-end mb-4">
			@Link("/holdings/"+strconv.Itoa(vm.ID)+"/trades/new", "+ New Trade")
		</div>
	</div>
	@Section() {
		<div>
			if len(vm.Trades) == 0 {
				<p class="text-gray-600">No trades recorded yet.</p>
			} else {
				<div class="overflow-x-auto">
					@PaginatedTableList(vm.PageInfo.CurrentPage, vm.PageInfo.TotalPages, vm.PageInfo.StartPage, vm.PageInfo.EndPage, vm.PageInfo.PreviousPage, vm.PageInfo.NextPage) {
						@THead() {
							@TH("Date")
							@TH("Action")
							@TH("Quantity")
							@TH("Price")
							@TH("Currency")
							@TH("Actions")
						}
						<tbody>
							for _, trade := range vm.Trades {
								<tr>
									@TD(trade.TransactionDate)
									@TD(trade.Action)
									@TD(fmt.Sprintf("%.2f", trade.Quantity))
									@TD(fmt.Sprintf("%.2f", trade.Price))
									@TD(trade.Currency)
									@TDChild() {
										<a href={ templ.SafeURL(trade.URL) } class="inline-block px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 mx-auto">
											View
										</a>
									}
								</tr>
							}
						</tbody>
					}
				</div>
			}
		</div>
	}
}
