package holdings

import (
	"fif-calculator/internal/viewmodel"
	"strconv"

	. "fif-calculator/views"
	"fmt"
)

templ ViewHolding(currentPath string, vm viewmodel.HoldingViewModel) {
	@Layout("Holding Details", currentPath) {
		@Page() {
			@Section() {
				@holdingInfo(vm)
			}
			@Section() {
				@holdingTrades(vm)
			}
		}
	}
}

templ holdingInfo(vm viewmodel.HoldingViewModel) {
	<div class="mb-4">
		<a href="/holdings" class="text-blue-600 underline">
			← Back to Holdings
		</a>
	</div>
	@H2("Holding Information")
	<div class="mb-4">
		<p class="text-sm text-gray-600">Name</p>
		<p class="text-lg text-gray-900 font-medium">{ vm.Name }</p>
	</div>
	<div class="mb-4">
		<p class="text-sm text-gray-600">Symbol</p>
		<p class="text-lg text-gray-900 font-medium">{ vm.Symbol }</p>
	</div>
	<div class="mb-4">
		<p class="text-sm text-gray-600">Currency</p>
		<p class="text-lg text-gray-900 font-medium">{ vm.Currency }</p>
	</div>
	@Link("/holdings/"+strconv.Itoa(vm.ID)+"/edit", "Edit")
	<form action={ templ.SafeURL("/holdings/" + strconv.Itoa(vm.ID) + "/delete") } method="post" onsubmit="return confirm('Are you sure you want to delete this holding?');">
		@DestructButton("Delete")
	</form>
}

templ holdingTrades(vm viewmodel.HoldingViewModel) {
	<div>
		<h2 class="text-2xl font-bold mb-4">Trades</h2>
		<div class="flex justify-end mb-4">
			@Link("/holdings/"+strconv.Itoa(vm.ID)+"/trades/new", "+ New Trade")
		</div>
		if len(vm.Trades) == 0 {
			<p class="text-gray-600">No trades recorded yet.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="min-w-full divide-y divide-gray-200 border border-gray-300 rounded">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Date</th>
							<th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Action</th>
							<th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Quantity</th>
							<th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Price</th>
							<th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Currency</th>
							<th class="px-4 py-2 text-sm font-semibold text-gray-700">Actions</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-100">
						for _, trade := range vm.Trades {
							<tr>
								<td class="px-4 py-2 text-sm text-gray-900">{ trade.TransactionDate }</td>
								<td class="px-4 py-2 text-sm text-gray-900">{ trade.Action }</td>
								<td class="px-4 py-2 text-sm text-gray-900">{ fmt.Sprintf("%.2f", trade.Quantity) }</td>
								<td class="px-4 py-2 text-sm text-gray-900">{ fmt.Sprintf("%.2f", trade.Price) }</td>
								<td class="px-4 py-2 text-sm text-gray-900">{ trade.Currency }</td>
								<td class="px-4 py-2 text-sm text-center">
									<a href={ templ.SafeURL(trade.URL) } class="inline-block px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 mx-auto">
										View
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
