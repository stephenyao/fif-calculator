package fif

import "fmt"
import . "fif-calculator/internal/model"

templ HoldingsInputForm(holdings []*HoldingQuantity, year int) {
	<form
		hx-post="/fif/calculate"
		hx-target="#fif-result"
		hx-swap="innerHTML"
		class="space-y-6"
	>
		<div class="space-y-6">
			for _, h := range holdings {
				<div class="bg-white border border-gray-200 rounded-lg p-6">
					<div class="mb-4">
						<h4 class="text-lg font-medium text-gray-900">{ h.Symbol }</h4>
						<div class="text-sm text-gray-600 mt-1">
							<span>Qty on 1 Apr { year - 1 }: { h.QuantityStart }</span>
							<span class="mx-4">•</span>
							<span>Qty on 31 Mar { year }: { h.QuantityEnd }</span>
						</div>
					</div>
					<input type="hidden" name={ "symbol_" + h.Symbol } value={ h.Symbol }/>
					<input type="hidden" name={ "quantity_start_" + h.Symbol } value={ fmt.Sprintf("%.4f", h.QuantityStart) }/>
					<input type="hidden" name={ "quantity_end_" + h.Symbol } value={ fmt.Sprintf("%.4f", h.QuantityEnd) }/>
					<input type="hidden" name="financialYear" value={ year }/>
					<!-- Price Information -->
					<div class="mb-6">
						<h5 class="text-md font-medium text-gray-900 mb-3">Price Information</h5>
						@grid() {
							@input("Opening Price (NZD)", "price-start-{h.Symbol}", "price-start-{h.Symbol}")
							@input("Closing Price (NZD)", "price-end-{h.Symbol}", "price_end_{h.Symbol}")
						}
					</div>
					<!-- Income and Costs -->
					<div class="mb-6">
						<h5 class="text-md font-medium text-gray-900 mb-3">Income</h5>
						@grid() {
							@input("Dividends (NZD)", "dividends-{h.Symbol}", "dividends_{h.Symbol}")
							@input("Tax Credits (NZD)", "tax-credits-{h.Symbol}", "tax_credits_{h.Symbol}")
							@input("Other Gains (NZD)", "other-gains-{h.Symbol}", "other_gains_{h.Symbol}")
						}
					</div>
					<div class="mb-3">
						<h5 class="text-md font-medium text-gray-900 mb-3">Costs</h5>
						@grid() {
							@input("Foreign Income Tax (NZD)", "foreign-income-tax-{h.Symbol}", "foreign_income_tax_{h.Symbol}")
							@input("Other Costs (NZD)", "other-costs-{h.Symbol}", "other_costs_{h.Symbol}")
						}
					</div>
				</div>
			}
		</div>
		<div class="flex justify-center">
			<button
				type="submit"
				class="px-6 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
			>
				Calculate FIF
			</button>
		</div>
	</form>
}

templ grid() {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">
		{ children... }
	</div>
}

templ input(label, id, name string) {
	<div>
		<label class="block text-sm font-medium text-gray-700 mb-1" for={ id }>
			{ label }
		</label>
		<input
			type="number"
			step="0.01"
			min="0"
			id={ id }
			name={ name }
			class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
			placeholder="5.00"
			value="0.00"
		/>
	</div>
}
