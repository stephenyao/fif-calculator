package fif

import "fmt"
import . "fif-calculator/internal/model"
import . "fif-calculator/views"

templ RenderHoldingDetail(holding *HoldingInfo, year int) {
	<form method="POST" action="/fif/calculate" class="space-y-6" id="fif-form">
		@HoldingPanel(holding, year)
			<div id="calculate-btn" class="hidden">
        		@Section() {
        			<button
        				type="submit"
        				name="action"
        				value="calculate"
        				class="px-6 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors
                               dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus:ring-blue-400 dark:focus:ring-offset-gray-900"
        			>
        				Calculate FIF
        			</button>
        		}
        	</div>
	</form>
}

templ HoldingsInputForm(holdings []*HoldingInfo, year int) {
	@InitializeClientSideScripts(holdings)
	@Section() {
		<div class="mb-2">
			<p>Please fill in the required information for each holding</p>
		</div>
		<div id="holdings-segment" class="flex flex-wrap gap-2">
			for _, h := range holdings {
				<button
					type="button"
					class="holding-btn px-3 py-1.5 text-sm rounded-md border transition-colors
                         focus:outline-none focus:ring-2 focus:ring-blue-500/30 dark:focus:ring-blue-400/30
                         bg-white text-gray-800 border-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-100 dark:border-gray-700 dark:hover:bg-gray-700"
					data-symbol={ h.Symbol }
					hx-get={ h.GetHoldingFIFInfoURL() }
					hx-target="#holding-panel"
					hx-swap="innerHTML"
					onclick={ templ.JSFuncCall("handleHoldingClicked", templ.JSExpression("event"), h.Symbol) }
				>
					<span class="label">{ h.Symbol }</span>
					<span class="tick hidden ml-2">✔</span>
				</button>
			}
		</div>
	}
	@Section() {
		@RenderHoldingDetail(holdings[0], year)
	}
}

templ InitializeClientSideScripts(data []*HoldingInfo) {
	<script src="/static/js/fifCalculate.js" onload={ templ.JSFuncCall("initRequiredSymbols", data) }>
    </script>
}

templ HoldingPanel(h *HoldingInfo, year int) {
	<div id="holding-panel">
		<div>
			<div class="mb-4">
				@H4(h.Symbol)
				<div class="text-sm text-gray-600 mt-1 dark:text-gray-400">
					<span>Qty on 1 Apr { year - 1 }: { h.QuantityStart }</span>
					<span class="mx-4">•</span>
					<span>Qty on 31 Mar { year }: { h.QuantityEnd }</span>
				</div>
				if h.NumberOfTrades > 0 {
					@caption() {
						There were a total of { h.NumberOfTrades } trades during the period
					}
				}
			</div>
			<input type="hidden" name={ "symbol_" + h.Symbol } value={ h.Symbol }/>
			<input type="hidden" name={ "quantity_start_" + h.Symbol } value={ fmt.Sprintf("%.2f", h.QuantityStart) }/>
			<input type="hidden" name={ "quantity_end_" + h.Symbol } value={ fmt.Sprintf("%.2f", h.QuantityEnd) }/>
			<input type="hidden" name="financialYear" value={ year }/>

			@PanelSection() {
			    @H5("Opening Price")
			    @caption() {
			       Enter the unit price per share and exchange rate to NZD as at 1 Apr { year - 1}
			    }
			    @grid() {
			        @input(h.Symbol, "Opening Price (" + h.Currency + ")", "price_start", "price_start", fmt.Sprintf("%.2f", h.OpeningPrice), true)
			        @input(h.Symbol, "Exchange Rate", "price_start_exchange", "price_start_exchange", fmt.Sprintf("%.2f", h.OpeningExchangeRate), true)
			    }
			}

			@PanelSection() {
			    @H5("Closing Price")
			    @caption() {
			       Enter the unit price per share and exchange rate to NZD as at 31 Mar { year}
			    }
			    @grid() {
			        @input(h.Symbol, "Closing Price (" + h.Currency + ")", "price_end", "price_end", fmt.Sprintf("%.2f", h.ClosingPrice), true)
			        @input(h.Symbol, "Exchange Rate", "price_end_exchange", "price_end_exchange", fmt.Sprintf("%.2f", h.ClosingExchangeRate), true)
			    }
			}

			<!-- Income -->
			@PanelSection() {
				@H5("Income")
				@grid() {
					@input(h.Symbol, "Proceeds from sales (NZD)", "proceeds_from_sales", "proceeds_from_sales", fmt.Sprintf("%.2f", h.ProceedsFromSales), true)
					@input(h.Symbol, "Dividends (NZD)", "dividends", "dividends", fmt.Sprintf("%.2f", h.GainLoss.Dividends), true)
					@input(h.Symbol, "Other Gains (NZD)", "other_gains", "other_gains", fmt.Sprintf("%.2f", h.GainLoss.OtherGains), true)
				}
			}
			<!-- Costs -->
			@PanelSection() {
				@H5("Costs")
				@grid() {
					@input(h.Symbol, "Cost of purchases (NZD)", "cost_of_purchases", "cost_of_purchases", fmt.Sprintf("%.2f", h.CostOfPurchases), true)
					@input(h.Symbol, "Other Costs (NZD)", "other_costs", "other_costs", fmt.Sprintf("%.2f", h.GainLoss.OtherCosts), true)
				}
			}
		</div>
		<!-- Full-width Verify button -->
		<div class="mt-6">
			<button
				id="markdone-btn"
				type="button"
				onclick={ templ.JSFuncCall("markHoldingDone", h.Symbol) }
				class="w-full px-6 py-3 bg-gray-200 text-gray-900 font-medium rounded-md
                      hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500
                      dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600"
			>
				Mark as Done
			</button>
		</div>
	</div>
}

templ PanelSection() {
	<div class="mb-6 flex flex-col space-y-3">
	    { children... }
	</div>
}

templ NoFIFApplicable() {
	<div class="text-gray-900 dark:text-gray-100">FIF not applicable</div>
}

templ caption() {
    <div class="text-sm text-gray-600 mt-1 dark:text-gray-400">
        { children... }
    </div>
}

templ grid() {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">
		{ children... }
	</div>
}

templ input(symbol, label, id, name string, value string, enabled bool) {
	<div>
		<label
			class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300"
			for={ id + "_" + symbol }
		>
			{ label }
		</label>
		<input
			type="number"
			step="0.01"
			min="0"
			id={ id + "_" + symbol }
			name={ name + "_" + symbol }
			class="block w-full px-3 py-2 border border-gray-300 rounded-md
				       bg-white text-gray-900 placeholder:text-gray-400
				       focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500
				       dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:placeholder:text-gray-500
				       dark:focus:ring-blue-400 dark:focus:border-blue-400"
			placeholder="5.00"
			value={ value }
		/>
	</div>
}
