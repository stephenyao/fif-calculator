package fif

import "fmt"
import . "fif-calculator/internal/model"

templ HoldingsInputForm(holdings []*HoldingInfo, year int) {
	<form
		hx-post="/fif/calculate"
		hx-target="#fif-result"
		hx-swap="innerHTML"
		class="space-y-6"
	>
		<div class="space-y-6">
			for _, h := range holdings {
				<div class="bg-white border border-gray-200 rounded-lg p-6">
					<div class="mb-4">
						<h4 class="text-lg font-medium text-gray-900">{ h.Symbol }</h4>
						<div class="text-sm text-gray-600 mt-1">
							<span>Qty on 1 Apr { year - 1 }: { h.QuantityStart }</span>
							<span class="mx-4">•</span>
							<span>Qty on 31 Mar { year }: { h.QuantityEnd }</span>
						</div>
						<div class="text-sm text-gray-600 mt-1">
							if h.NumberOfTrades > 0 {
								<div>There were a total of { h.NumberOfTrades } trades during the period </div>
							}
						</div>
					</div>
					<input type="hidden" name={ "symbol_" + h.Symbol } value={ h.Symbol }/>
					<input type="hidden" name={ "quantity_start_" + h.Symbol } value={ fmt.Sprintf("%.2f", h.QuantityStart) }/>
					<input type="hidden" name={ "quantity_end_" + h.Symbol } value={ fmt.Sprintf("%.2f", h.QuantityEnd) }/>
					<input type="hidden" name="financialYear" value={ year }/>
					<!-- Price Information -->
					<div class="mb-6">
						<h5 class="text-md font-medium text-gray-900 mb-3">Price Information</h5>
						@grid() {
							@input(h.Symbol, "Opening Price (NZD)", "price-start", "price_start", "0.00", true)
							@input(h.Symbol, "Closing Price (NZD)", "price-end", "price_end", "0.00", true)
						}
					</div>
					<!-- Income and Costs -->
					<div class="mb-6">
						<h5 class="text-md font-medium text-gray-900 mb-3">Income</h5>
						@grid() {
							@input(h.Symbol, "Proceeds from sales", "proceeds-from-sales", "proceeds-from-sales", fmt.Sprintf("%.2f", h.ProceedsFromSales), false)
							@input(h.Symbol, "Dividends (NZD)", "dividends", "dividends", "0.00", true)
							@input(h.Symbol, "Tax Credits (NZD)", "tax-credits", "tax_credits", "0.00", true)
							@input(h.Symbol, "Other Gains (NZD)", "other-gains", "other_gains", "0.00", true)
						}
					</div>
					<div class="mb-3">
						<h5 class="text-md font-medium text-gray-900 mb-3">Costs</h5>
						@grid() {
							@input(h.Symbol, "Cost of purchases", "cost-of-purchases", "cost_of_purchases", fmt.Sprintf("%.2f", h.CostOfPurchases), false)
							@input(h.Symbol, "Foreign Income Tax (NZD)", "foreign-income-tax", "foreign_income_tax", "0.00", true)
							@input(h.Symbol, "Other Costs (NZD)", "other-costs", "other_cost", "0.00", true)
						}
					</div>
				</div>
			}
		</div>
		<div class="flex justify-center">
			<button
				type="submit"
				class="px-6 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
			>
				Calculate FIF
			</button>
		</div>
	</form>
}

templ NoFIFApplicable() {
	<div>FIF not applicable</div>
}

templ grid() {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">
		{ children... }
	</div>
}

templ input(symbol, label, id, name string, value string, enabled bool) {
	<div>
		<label class="block text-sm font-medium text-gray-700 mb-1" for={ id + "-" + symbol }>
			{ label }
		</label>
		if enabled {
			<input
				type="number"
				step="0.01"
				min="0"
				id={ id + "-" + symbol }
				name={ name + "_" + symbol }
				class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
				placeholder="5.00"
				value={value}
			/>
		} else {
			<input
				type="number"
				min="0"
				id={ id + "-" + symbol }
				name={ name + "_" + symbol }
				class="block w-full px-3 py-2 border border-gray-300 bg-gray-100 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
				value={value}
				disabled
			/>
		}
	</div>
}
