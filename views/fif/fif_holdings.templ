package fif

import "fmt"
import . "fif-calculator/internal/model"
import . "fif-calculator/views"

templ RenderHoldingDetail(holding *HoldingInfo, year int) {
	<form
		hx-post="/fif/calculate"
		hx-target="#fif-result"
		hx-swap="innerHTML"
		class="space-y-6"
		id="fif-form"
	>
        @HoldingPanel(holding, year)
	</form>
}


templ HoldingsInputForm(holdings []*HoldingInfo, year int) {
	@InitializeClientSideScripts(holdings)
	@Section() {
		<div id="holdings-segment"class="flex flex-wrap gap-2">
			for _, h := range holdings {
				<button
					type="button"
					class="px-3 py-1.5 text-sm rounded-md border transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500/30 dark:focus:ring-blue-400/30 bg-white text-gray-800 border-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-100 dark:border-gray-700 dark:hover:bg-gray-700"
					data-symbol={h.Symbol}
					hx-get={h.GetHoldingFIFInfoURL()}
					hx-target="#holding-panel"
					hx-swap="innerHTML"
				>
					{h.Symbol}
				</button>
			}
		</div>
	}
	@Section() {
	    @RenderHoldingDetail(holdings[0], year)
	}
	@Section() {
        <button
            type="submit"
            name="action"
            value="calculate"
            class="px-6 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors
                       dark:bg-blue-500 dark:hover:bg-blue-400 dark:focus:ring-blue-400 dark:focus:ring-offset-gray-900"
        >
            Calculate FIF
        </button>
	}
}

templ InitializeClientSideScripts(data []*HoldingInfo) {
	@Scripts()
}

templ Scripts() {
    <script>
        (function () {
            // guard against re-running if this script is included multiple times
            if (window.__fifInit) return;
            window.__fifInit = true;

            // global cache of values: { "price-start-AAPL": "123.45", ... }
            window.fifState = window.fifState || {};

            // --- helpers ---
            function applyCacheToPanel(rootEl) {
                if (!rootEl) return;
                // apply cached values to any numeric input with an id
                rootEl.querySelectorAll('input[type="number"][id]').forEach(el => {
                    const key = el.id;               // e.g. "price-start-AAPL"
                    if (key in window.fifState) {
                        el.value = window.fifState[key];
                    }
                });
            }

            function capturePanelIntoCache(rootEl) {
                if (!rootEl) return;
                rootEl.querySelectorAll('input[type="number"][id]').forEach(el => {
                    window.fifState[el.id] = el.value;
                });
            }

            function wireFormChangeListener() {
                const form = document.getElementById('fif-form');
                if (!form || form.__fifWired) return;
                form.addEventListener('change', (e) => {
                    const el = e.target;
                    if (!(el instanceof HTMLInputElement)) return;
                    if (el.type !== 'number') return;
                    if (!el.id) return;
                    window.fifState[el.id] = el.value;
                    // console.log('fifState updated:', el.id, '=', el.value);
                });
                form.__fifWired = true;
            }

            // Initial wire-up and first-visit hydration
            document.addEventListener('DOMContentLoaded', () => {
                wireFormChangeListener();
                applyCacheToPanel(document.getElementById('holding-panel'));
            });

            // Before HTMX request (user clicked another symbol): snapshot current panel,
            // so we don't lose in-progress edits if the user didn't blur the field.
            document.body.addEventListener('htmx:beforeRequest', (e) => {
                const panel = document.getElementById('holding-panel');
                capturePanelIntoCache(panel);
            });

            // After HTMX swaps in the new holding panel: hydrate from cache and (re)wire
            document.body.addEventListener('htmx:afterSwap', (e) => {
                if (e.target && e.target.id === 'holding-panel') {
                    applyCacheToPanel(e.target);
                    wireFormChangeListener();
                }
            });
        })();
    </script>
}

templ HoldingPanel(h *HoldingInfo, year int) {
	<div id="holding-panel">
		<div>
			<div class="mb-4">
				@H4(h.Symbol)
				<div class="text-sm text-gray-600 mt-1 dark:text-gray-400">
					<span>Qty on 1 Apr { year - 1 }: { h.QuantityStart }</span>
					<span class="mx-4">•</span>
					<span>Qty on 31 Mar { year }: { h.QuantityEnd }</span>
				</div>
				if h.NumberOfTrades > 0 {
					<div class="text-sm text-gray-600 mt-1 dark:text-gray-400">
						There were a total of { h.NumberOfTrades } trades during the period
					</div>
				}
			</div>

			<input type="hidden" name={ "symbol_" + h.Symbol } value={ h.Symbol }/>
			<input type="hidden" name={ "quantity_start_" + h.Symbol } value={ fmt.Sprintf("%.2f", h.QuantityStart) }/>
			<input type="hidden" name={ "quantity_end_" + h.Symbol } value={ fmt.Sprintf("%.2f", h.QuantityEnd) }/>
			<input type="hidden" name="financialYear" value={ year }/>

			<!-- Price Information -->
			<div class="mb-6 flex flex-col space-y-3">
				@H5("Price Information")
				@grid() {
					@input(h.Symbol, "Opening Price (NZD)", "price-start", "price_start", fmt.Sprintf("%.2f", h.OpeningPrice), true)
					@input(h.Symbol, "Closing Price (NZD)", "price-end", "price_end", fmt.Sprintf("%.2f", h.ClosingPrice), true)
				}
			</div>

			<!-- Income -->
			<div class="mb-6 flex flex-col space-y-3">
				@H5("Income")
				@grid() {
					@input(h.Symbol, "Proceeds from sales", "proceeds-from-sales", "proceeds_from_sales", fmt.Sprintf("%.2f", h.ProceedsFromSales), true)
					@input(h.Symbol, "Dividends (NZD)", "dividends", "dividends", fmt.Sprintf("%.2f", h.GainLoss.Dividends), true)
					@input(h.Symbol, "Tax Credits (NZD)", "tax-credits", "tax_credits", fmt.Sprintf("%.2f", h.GainLoss.TaxCredits), true)
					@input(h.Symbol, "Other Gains (NZD)", "other-gains", "other_gains", fmt.Sprintf("%.2f", h.GainLoss.OtherGains), true)
				}
			</div>

			<!-- Costs -->
			<div class="mb-6 flex flex-col space-y-3">
				@H5("Costs")
				@grid() {
					@input(h.Symbol, "Cost of purchases", "cost-of-purchases", "cost_of_purchases", fmt.Sprintf("%.2f", h.CostOfPurchases), true)
					@input(h.Symbol, "Foreign Income Tax (NZD)", "foreign-income-tax", "foreign_income_tax", fmt.Sprintf("%.2f", h.GainLoss.ForeignIncomeTax), true)
					@input(h.Symbol, "Other Costs (NZD)", "other-costs", "other_costs", fmt.Sprintf("%.2f", h.GainLoss.OtherCosts), true)
				}
			</div>
		</div>
	</div>
}


templ NoFIFApplicable() {
	<div class="text-gray-900 dark:text-gray-100">FIF not applicable</div>
}

templ grid() {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">
		{ children... }
	</div>
}

templ input(symbol, label, id, name string, value string, enabled bool) {
	<div>
		<label
			class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300"
			for={ id + "-" + symbol }
		>
			{ label }
		</label>
			<input
				type="number"
				step="0.01"
				min="0"
				id={ id + "-" + symbol }
				name={ name + "_" + symbol }
				class="block w-full px-3 py-2 border border-gray-300 rounded-md
				       bg-white text-gray-900 placeholder:text-gray-400
				       focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500
				       dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:placeholder:text-gray-500
				       dark:focus:ring-blue-400 dark:focus:border-blue-400"
				placeholder="5.00"
				value={ value }
			/>
	</div>
}
