package fif

import . "fif-calculator/views"
import . "fif-calculator/internal/viewmodel"
import . "fif-calculator/internal/model"
import "fmt"
import "time"

templ Start(currentPath string) {
    @Layout("Start FIF Calculation", currentPath) {
        @Page() {
            @Section() {
                @fifStartPage()
            }
        }
	}
}

templ fifStartPage() {
    <form hx-post="/fif/start" hx-target="#holdings-results" hx-swap="innerHTML" class="space-y-4">
        <label for="financialYear" class="block font-medium">Financial Year Ending</label>
        <select id="financialYear" name="financialYear" class="w-full p-2 border border-gray-300 rounded">
            for year := 2019; year <= time.Now().Year() + 1; year++ {
                <option value={year}>{fmt.Sprintf("1 Apr %d – 31 Mar %d", year-1, year)}</option>
            }
        </select>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Continue</button>
    </form>

    <div id="holdings-results" class="mt-8"></div>
}

templ RenderFIFHoldingQuantities(holdings []*HoldingQuantity, year int) {
    <div class="max-w-4xl mx-auto p-6">
        <div class="mb-8">
            <h3 class="text-2xl font-semibold text-gray-900 mb-2">
                Holdings for Financial Year {year - 1}–{year}
            </h3>
        </div>

        @HoldingsInputForm(holdings, year)

        <div id="fif-result" class="mt-6"></div>
    </div>
}

templ RenderFIFResult(vm FIFCalculationViewModel) {
    <div>
        <h4 class="text-lg font-semibold mb-3">
            FIF Calculation Results for {vm.Year - 1}–{vm.Year}
        </h4>

        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b">
                    <th class="py-1">Symbol</th>
                    <th class="py-1">Start Value (NZD)</th>
                    <th class="py-1">Quick sale adjustment</th>
                    <th class="py-1">FDR Income</th>
                </tr>
            </thead>
            <tbody>
                for _, r := range vm.Results {
                    <tr class="border-t">
                        <td>{r.Symbol}</td>
                        <td>{fmt.Sprintf("%.2f", r.StartValue)}</td>
                        <td class="font-semibold text-blue-700">{fmt.Sprintf("%.2f", r.QuickSaleAdjustment)}</td>
                        <td class="font-semibold text-blue-700">{fmt.Sprintf("%.2f", r.TotalFDRIncome())}</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-4 text-right font-bold text-lg">
            Total FIF Income:
            <span class="text-green-700">{fmt.Sprintf("%.2f", vm.TotalFDR)} NZD</span>
        </div>
    </div>
}
