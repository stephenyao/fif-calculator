package fif

import . "fif-clacultor/views"

templ Index(currentPath string) {
    @Layout("FIF", currentPath) {
        @Page() {
            @Section() {
                @body()
            }
        }
	}
}

templ body() {
    <div class="flex items-center justify-between">
        <p>Start a new FIF calculation</p>
        @Link("/fif/start", "New calculation")
    </div>
}