package trades

import "fif-calculator/views"
import "fif-calculator/internal/model"

templ TradeDetail(curentPath string, trade *model.Trade, backURL, editURL, deleteURL string) {
	@views.Layout("Trade detail", curentPath) {
		@details(trade, backURL, editURL, deleteURL)
	}
}

templ details(trade *model.Trade, backURL, editURL, deleteURL string) {
	<div class="max-w-2xl mx-auto p-6">
		<h1 class="text-2xl font-bold mb-4">Trade Details</h1>
		<table class="w-full text-left border-collapse">
			<tbody>
				<tr>
					<th class="py-2 pr-4 text-gray-500">Holding</th>
					<td class="py-2">{ trade.HoldingName }</td>
				</tr>
				<tr>
					<th class="py-2 pr-4 text-gray-500">Symbol</th>
					<td class="py-2">{ trade.Symbol }</td>
				</tr>
				<tr>
					<th class="py-2 pr-4 text-gray-500">Buy Date</th>
					<td class="py-2">{ trade.BuyDate }</td>
				</tr>
				<tr>
					<th class="py-2 pr-4 text-gray-500">Quantity</th>
					<td class="py-2">{ trade.Quantity }</td>
				</tr>
				<tr>
					<th class="py-2 pr-4 text-gray-500">Price</th>
					<td class="py-2">{ trade.Price }</td>
				</tr>
				<tr>
					<th class="py-2 pr-4 text-gray-500">Currency</th>
					<td class="py-2">{ trade.Currency }</td>
				</tr>
				<tr>
					<th class="py-2 pr-4 text-gray-500">Action</th>
					<td class="py-2">{ trade.Action }</td>
				</tr>
			</tbody>
		</table>
		<a href={ templ.SafeURL(editURL) } class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
			Edit Trade
		</a>
		<form action={ templ.SafeURL(deleteURL) } method="post" onsubmit="return confirm('Are you sure you want to delete this trade?');">
			<button type="submit" class="mt-4 bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">
				Delete Trade
			</button>
		</form>
		<div class="mt-6">
			<a href={ templ.SafeURL(backURL) } class="text-blue-600 underline">← Back to Holding</a>
		</div>
	</div>
}
