package trades

import (
	"fif-calculator/internal/model"
	"fif-calculator/internal/viewmodel"
	. "fif-calculator/views"
)

templ TradeDetail(curentPath string, vm viewmodel.TradeDetailsViewModel, backURL, editURL, deleteURL string) {
	@Layout("Trade detail", curentPath) {
		@Page() {
			<div class="mb-4 flex flex-col gap-4">
				@BackLink(backURL, "")
				<div class="flex justify-between items-center">
					@H2(vm.HoldingName + " (" + vm.Symbol + ")")
					<div class="flex items-center gap-2">
						@Link(editURL, "Edit")
						<form action={ deleteURL } method="post" onsubmit="return confirm('Are you sure you want to delete this trade?');">
							@DestructButton("Delete")
						</form>
					</div>
				</div>
			</div>
			@Section() {
				<div class="grid grid-cols-2 gap-x-6 gap-y-2">
					<div class="mb-4">
						@VPairedLabel("Date", vm.Date)
					</div>
					<div class="mb-4">
						@VPairedLabel("Quantity", vm.Quantity)
					</div>
					<div class="mb-4">
						@VPairedLabel("Price", vm.Price)
					</div>
					<div class="mb-4">
						@VPairedLabel("Currency", vm.Currency)
					</div>
					<div class="mb-4">
						@VPairedLabel("Exchange Rate", vm.ExchangeRate)
					</div>
					<div class="mb-4">
						@VPairedLabel("Action", vm.Action)
					</div>
				</div>
			}
		}
	}
}

templ details(trade *model.Trade, backURL, editURL, deleteURL string) {
	<div class="max-w-2xl mx-auto p-6">
		<a href={ templ.SafeURL(editURL) } class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
			Edit Trade
		</a>
		<form action={ templ.SafeURL(deleteURL) } method="post" onsubmit="return confirm('Are you sure you want to delete this trade?');">
			<button type="submit" class="mt-4 bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">
				Delete Trade
			</button>
		</form>
		<div class="mt-6">
			<a href={ templ.SafeURL(backURL) } class="text-blue-600 underline">← Back to Holding</a>
		</div>
	</div>
}
