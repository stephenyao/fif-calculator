package trades

import . "fif-calculator/views"
import "fif-calculator/internal/model"
import "fif-calculator/internal/viewmodel"

templ UpdateTradeForm(currentPath string, trade *model.Trade, vm viewmodel.TradeFormViewModel) {
    @Layout("Update Trade", currentPath) {
         @Page() {
            @Section() {
                 @TradeForm(trade, vm.ActionURL, vm)
            }
        }
    }
}