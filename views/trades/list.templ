package trades

import "fif-clacultor/views"
import "fif-clacultor/internal/model"
import . "fif-clacultor/internal/viewmodel"
import "strconv"

templ TradeList(trades []model.Trade, viewModel CostBasisViewModel) {
    @views.Layout("Trade List") {
        <div class="min-h-screen bg-gray-100 p-6 flex flex-col gap-4">
            @list(trades)
            @costBasis(viewModel)
        </div>
    }
}

templ costBasis(viewModel CostBasisViewModel) {
     <div class="max-w-4xl w-full mx-auto bg-white shadow-md rounded-xl p-6 space-y-6">
        <script>
            function onClickCostBasisWarning(event) {
                alert("Your sell orders quantity exceed buy orders quantity")
            }
        </script>
        <h2 class="text-xl font-semibold text-gray-800">Cost Basis Summary</h2>

        <div class="flex flex-wrap gap-4">
             for symbol, costBasisSymbol := range viewModel.CostBasisBySymbol {
                 <div class="rounded-lg border border-gray-200 p-4 shadow-sm bg-gray-50 w-full sm:w-1/2 md:w-1/3">
                     <div class="flex items-center justify-between">
                         <h3 class="font-medium text-gray-700">{symbol}</h3>
                            if costBasisSymbol.Oversold {
                                <button
                                    class="ml-2 text-yellow-600 hover:text-yellow-800"
                                    onclick="onClickCostBasisWarning(this)"
                                    aria-label="Show warning"
                                >
                                    ⚠️
                                </button>
                            }
                     </div>
                     <p class="text-gray-600">Cost basis: ${costBasisSymbol.CostBasis}</p>
                 </div>
             }
        </div>

         <div class="pt-4 border-t border-gray-200">
             <p class="text-gray-800 font-medium">
                 Total Cost Basis: <span class="font-semibold">${viewModel.TotalCostBasis}</span>
             </p>
             <p class="text-sm text-gray-500">
                FIF Threshold Met:
                if viewModel.IsValidForFIF {
                   <span class="text-green-600 font-semibold">Yes</span>
                } else {
                   <span class="text-red-600 font-semibold">No</span>
                }
             </p>
         </div>

         <div class="pt-2 text-sm text-gray-500 italic">
             * Cost basis calculated using the FIFO (First-In, First-Out) accounting method.
         </div>
     </div>
}

templ list(trades []model.Trade) {
    <div class="">
        <div class="max-w-4xl mx-auto bg-white shadow-md rounded-xl p-6">
            <h2 class="text-2xl font-bold mb-4">Trade List</h2>
            <div class="flex justify-end mb-4">
                <a href="/trades/new" class="inline-block bg-blue-600 text-white font-medium py-2 px-4 rounded hover:bg-blue-700 transition">
                    + New Trade
                </a>
            </div>
            <table class="min-w-full table-auto border-collapse">
                <thead>
                    <tr class="bg-gray-200 text-left">
                        <th class="px-4 py-2">Symbol</th>
                        <th class="px-4 py-2">Date</th>
                        <th class="px-4 py-2">Quantity</th>
                        <th class="px-4 py-2">Price</th>
                        <th class="px-4 py-2">Currency</th>
                        <th class="px-4 py-2">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <script>
                        function navigateToDetails(path) {
                          window.location.href=path
                        }
                    </script>
                    for _, trade := range trades {
                        <tr
                            onclick={templ.JSFuncCall("navigateToDetails", "trades/" + strconv.Itoa(trade.ID))}
                        	class="cursor-pointer hover:bg-blue-50 transition"
                        >
                            <td class="px-4 py-2">{trade.Symbol}</td>
                            <td class="px-4 py-2">{trade.BuyDate}</td>
                            <td class="px-4 py-2">{trade.Quantity}</td>
                            <td class="px-4 py-2">{trade.Price}</td>
                            <td class="px-4 py-2">{trade.Currency}</td>
                            <td class="px-4 py-2">{trade.Action}</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}