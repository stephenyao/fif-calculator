package costbasis

import . "fif-calculator/views"
import . "fif-calculator/internal/viewmodel"

templ Index(currentPath string, viewModel CostBasisViewModel) {
    @Layout("Cost basis", currentPath) {
        @body(viewModel)
    }
}

templ body(viewModel CostBasisViewModel) {
    @Page() {
        @Section() {
            @costBasis(viewModel)
        }
    }
}


templ costBasis(viewModel CostBasisViewModel) {
    <script>
        function onClickCostBasisWarning(event) {
            alert("Your sell orders quantity exceed buy orders quantity")
        }
    </script>
    <h2 class="text-xl font-semibold text-gray-800">Cost Basis Summary</h2>

    <div class="flex flex-wrap gap-4">
         for symbol, costBasisSymbol := range viewModel.CostBasisBySymbol {
             <div class="rounded-lg border border-gray-200 p-4 shadow-sm bg-gray-50 w-full sm:w-1/2 md:w-1/3">
                 <div class="flex items-center justify-between">
                     <h3 class="font-medium text-gray-700">{symbol}</h3>
                        if costBasisSymbol.Oversold {
                            <button
                                class="ml-2 text-yellow-600 hover:text-yellow-800"
                                onclick="onClickCostBasisWarning(this)"
                                aria-label="Show warning"
                            >
                                ⚠️
                            </button>
                        }
                 </div>
                 <p class="text-gray-600">Cost basis: ${costBasisSymbol.CostBasis}</p>
             </div>
         }
    </div>

     <div class="mt-4 pt-4 border-t border-gray-200">
         <p class="text-gray-800 font-medium">
             Total Cost Basis: <span class="font-semibold">${viewModel.TotalCostBasis}</span>
         </p>
         <p class="text-sm text-gray-500">
            FIF Threshold Met:
            if viewModel.IsValidForFIF {
               <span class="text-green-600 font-semibold">Yes</span>
            } else {
               <span class="text-red-600 font-semibold">No</span>
            }
         </p>
     </div>

     <div class="pt-2 text-sm text-gray-500 italic">
         * Cost basis calculated using the FIFO (First-In, First-Out) accounting method.
     </div>
}